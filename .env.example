# Every setting the stack reads, one line of comment each. Copy to .env and fill.
# Nothing may read process.env outside packages/shared/src/config.ts.

# --- runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# 1 prints human-readable logs locally; keep 0 in production.
LOG_PRETTY=0

# --- database (Neon) ---
# DATABASE_URL is the pooled connection the app uses at runtime.
# DATABASE_DIRECT_URL is the unpooled host used for migrations (prisma needs it).
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- secrets at rest ---
# base64 of 32 random bytes; the only key the crypto module signs credential blobs with.
CREDENTIALS_KEY=
CREDENTIALS_KEY_ID=k1
# Keep the previous key here while rotating so old blobs stay decryptable, then clear both.
CREDENTIALS_KEY_PREVIOUS=
CREDENTIALS_KEY_PREVIOUS_ID=
# base64 of 32 random bytes; session signing (used from Phase 2).
SESSION_SECRET=

# --- model provider: ollama (the same daemon the cli project runs) ---
# Orchestrator nodes call tools, and only a tool-capable model is accepted at
# activation: `POST /api/show {"model":...}` must list "tools" in capabilities.
# gemma4:31b-cloud is verified here; a model without tools is refused, not run.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_MS=60000

# --- queue: postgres (docs/decisions.md D7 — no redis in this build) ---
REDIS_URL=redis://127.0.0.1:6379
WORKER_LEASE_MS=120000
WORKER_POLL_MS=1500
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
WORKER_STALE_MS=30000
WORKFLOW_RUN_DEADLINE_MS=900000

# --- tool calling (every step is a separate billed model call) ---
AGENT_MAX_TOOL_STEPS=6
ORCHESTRATOR_MAX_SUBAGENT_CALLS=4

# --- site crawl (page routing) ---
# 1 lets the crawler reach localhost/private ranges; keep 0 outside local verification.
SITE_ALLOW_PRIVATE_IPS=0
SITE_CRAWL_TIMEOUT_MS=10000
SITE_CRAWL_MAX_PAGES=25
SITE_CRAWL_MAX_DEPTH=2
